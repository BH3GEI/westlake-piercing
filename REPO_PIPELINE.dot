digraph westlake_repo_skill {
  graph [
    skill="westlake-piercing",
    version="0.3",
    default_runner=".repo-skill/src/dot_runner.py"
  ];

  handoff [
    type="workflow",
    record="false",
    steps="verify_handoff"
  ];

  up [
    type="workflow",
    steps="doctor_host check_artifacts check_device runbook"
  ];

  check [
    type="workflow",
    steps="doctor_host verify_docs check_artifacts check_device runbook"
  ];

  dayu600_audit [
    type="workflow",
    steps="verify_handoff doctor_host verify_docs check_dayu600 runbook_dayu600"
  ];

  dayu600_2048 [
    type="workflow",
    steps="verify_docs check_dayu600 run_dayu600_2048_headless run_dayu600_2048_appspawn"
  ];

  cli_fleet [
    type="workflow",
    record="false",
    steps="verify_cli_fleet"
  ];

  cli_fleet_live [
    type="workflow",
    record="false",
    steps="verify_cli_fleet_live"
  ];

  sync [
    type="workflow",
    steps="sync_entries sync_skill sync_lock sync_history"
  ];

  verify_handoff [
    kind="cmd",
    cmd="python3 -B .repo-skill/src/westlake_checks.py handoff",
    purpose="read-only check of role entries, bounded state, task/board locks, frontier card, and Git worktree"
  ];

  verify_cli_fleet [
    kind="cmd",
    cmd="python3 -B oracle/verify/cli-fleet.py",
    purpose="no-persistent-mutation check of local CLI binaries, hashes, routes and catalogs plus temporary parallel-worktree and process-group timeout smokes"
  ];

  verify_cli_fleet_live [
    kind="cmd",
    cmd="python3 -B oracle/verify/cli-fleet.py --live",
    purpose="static fleet check plus temporary-directory Kimi/Claude/Codex worker smokes and a temporary-HOME current-model Cursor Agent hello; Kimi creates ordinary session metadata"
  ];

  doctor_host [
    kind="cmd",
    cmd="python3 .repo-skill/src/westlake_checks.py host",
    purpose="check host tools and reference paths"
  ];

  verify_docs [
    kind="cmd",
    cmd="python3 .repo-skill/src/westlake_checks.py docs",
    purpose="check that the reproduction docs and lock files are present"
  ];

  check_artifacts [
    kind="cmd",
    cmd="python3 .repo-skill/src/westlake_checks.py artifacts",
    purpose="check external binary baseline or rebuild inputs"
  ];

  check_device [
    kind="cmd",
    cmd="python3 .repo-skill/src/westlake_checks.py device",
    purpose="check DAYU200/RK3568 hdc reachability"
  ];

  check_dayu600 [
    kind="cmd",
    cmd="python3 .repo-skill/src/westlake_checks.py dayu600",
    purpose="check DAYU600/uis7885 hdc reachability and non-mutating substrate facts"
  ];

  runbook [
    kind="cmd",
    cmd="python3 .repo-skill/src/westlake_checks.py runbook",
    purpose="print the next replay documents and validation target"
  ];

  runbook_dayu600 [
    kind="cmd",
    cmd="python3 .repo-skill/src/westlake_checks.py runbook-dayu600",
    purpose="print the DAYU600 porting runbook and safety rules"
  ];

  run_dayu600_2048_headless [
    kind="cmd",
    cmd="python3 .repo-skill/src/westlake_checks.py dayu600-2048-headless",
    purpose="run the real 2048 APK MainActivity and game-model probe under standalone DAYU600 ART"
  ];

  run_dayu600_2048_appspawn [
    kind="cmd",
    cmd="python3 .repo-skill/src/westlake_checks.py dayu600-2048-appspawn",
    purpose="run the real 2048 APK onCreate probe inside the temporary AppSpawnX app child"
  ];

  sync_skill [
    kind="agent",
    purpose="update REPO_SKILL.md and .repo-skill/SKILL.md if project knowledge changed"
  ];

  sync_entries [
    kind="agent",
    purpose="keep AGENTS.md, CLAUDE.md, and both westlake-repo skill adapters aligned"
  ];

  sync_lock [
    kind="agent",
    purpose="update REPO_LOCK.toml if versions, hashes, hardware, tools, or artifacts changed"
  ];

  sync_history [
    kind="agent",
    purpose="append REPO_HISTORY.dot and .repo-skill/turns/<change>.md before commit"
  ];

  handoff -> verify_handoff;
  up -> doctor_host -> check_artifacts -> check_device -> runbook;
  check -> doctor_host -> verify_docs -> check_artifacts -> check_device -> runbook;
  dayu600_audit -> verify_handoff -> doctor_host -> verify_docs -> check_dayu600 -> runbook_dayu600;
  dayu600_2048 -> verify_docs -> check_dayu600 -> run_dayu600_2048_headless -> run_dayu600_2048_appspawn;
  cli_fleet -> verify_cli_fleet;
  cli_fleet_live -> verify_cli_fleet_live;
  sync -> sync_entries -> sync_skill -> sync_lock -> sync_history;
}
