# OHOS arm64 cross-compile toolchain (Mac local) — source this. SHELL IS ZSH.
export OHOS_SDK=/Users/yao/a2oh-source-audit/ohos-sdk/native
export OHOS_CLANG=$OHOS_SDK/llvm/bin/clang
export OHOS_CLANGXX=$OHOS_SDK/llvm/bin/clang++
export OHOS_SYSROOT=$OHOS_SDK/sysroot
export JNI_INC=/Users/yao/a2oh-source-audit/aosp-android-11/libnativehelper/include_jni
export LOG_INC=/Users/yao/westlake-local-build/art-latest/stubs   # <android/log.h>
export REF=/Users/yao/westlake-piercing/scratchpad-shared/audio-a2oh-ref
# ZSH note: pass --target/--sysroot as LITERAL separate args (no combined var; zsh won't split).
# canonical .so compile (C++):
#   $OHOS_CLANGXX --target=aarch64-linux-ohos --sysroot="$OHOS_SYSROOT" \
#     -std=c++2a -O2 -fPIC -w -shared -I"$JNI_INC" -I"$LOG_INC" src.cpp -o out.so
