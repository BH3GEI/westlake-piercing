# Large / un-rebuildable binaries are intentionally NOT committed.
# Their md5s + provenance are in REPRODUCE.md §11 and ARTIFACT-INVENTORY.txt.
*.so
*.so.*
*.apk
*.jar
*.hap
boot*.art
boot*.oat
boot*.vdex
*.oat
*.art
*.vdex
# allow the small committed blobs explicitly
!ca-store/cacerts.tgz
!scripts/SmaliAssemble.java
!native-libs/libv4force.so
!native-tls/libtlsjni.so
!native-tls/tlsjni-extra.dex

# Repo skill runtime output.
.repo-skill/last-run.json
.repo-skill/runs/

# Local device smoke logs and pulled evidence.
artifacts/

# Rebuildable DAYU600 fixture outputs.
test-fixtures/dayu600-*/out/
ports/dayu600/out/
ports/dayu600/device-libs/
entry-hap/dayu600-*/out/
entry-hap/dayu600-*/*.hap
.DS_Store

# Agent-Audio generated/temp build artifacts.
*.tmp
*.o
scratchpad-shared/audio-port-64/framework-smali/.classes/

# 白板时代 agent 轮询日志(2026-07-09 冻结):空转产物,不入 git。
scratchpad-shared/**/*-poll.log
