digraph westlake_repo_history {
  graph [
    format="repo-skill-history-v0",
    rule="each node records one agent-facing change; commit=self is allowed only for the node introduced by the current commit"
  ];

  repo_skill_v0 [
    commit="fb3661c",
    base_commit="b9ede74ac6a19e9e05e09800a4c8757b60ea48d5",
    actor="Yao/Codex",
    title="add repo skill v0",
    user_input="Fork westlake-piercing to BH3GEI and add a dynamic repo skill system with DOT pipeline, lock, history, and skill-local tools.",
    agent_action="Created REPO_SKILL.md, REPO_PIPELINE.dot, REPO_LOCK.toml, REPO_HISTORY.dot, .repo-skill/SKILL.md, runner code, checks, and turn notes.",
    code_delta="No runtime adapter behavior changed; added collaboration and reproducibility metadata plus a local DOT runner.",
    verify="static runner checks; full replay requires DAYU200 and artifact baseline",
    note=".repo-skill/turns/2026-06-30-repo-skill-v0.md"
  ];

  claude_code_adapter [
    commit="6113f4b",
    base_commit="fb3661c",
    actor="Yao/Codex",
    title="add Claude Code skill adapter",
    user_input="Add the Claude Code layer so Claude can discover the repo skill without duplicating the main rules.",
    agent_action="Created .claude/skills/westlake-repo/SKILL.md and linked REPO_SKILL.md as the single source of truth.",
    code_delta="No runtime adapter behavior changed; added Claude Code discovery metadata and updated repo skill history.",
    verify="static file checks; full replay still requires DAYU200, hdc, and external artifacts",
    note=".repo-skill/turns/2026-06-30-claude-code-adapter.md"
  ];

  repo_skill_cleanup [
    commit="f926081",
    base_commit="6113f4b",
    actor="Yao/Codex",
    title="clean up repo skill metadata",
    user_input="Inspect BH3GEI/westlake-piercing, especially its built-in repo skill.",
    agent_action="Added Codex frontmatter to .repo-skill/SKILL.md, rewrote mojibake Claude adapter and turn note, improved missing-command/9009 reporting, and recorded this cleanup turn.",
    code_delta="No runtime adapter behavior changed; cleaned repository skill metadata, agent-facing history, and runner diagnostics.",
    verify="static skill checks; repo-local check flow fails honestly on this Windows host before hardware/artifact verification",
    note=".repo-skill/turns/2026-07-01-repo-skill-cleanup.md"
  ];

  dayu600_port_target [
    commit="pending",
    base_commit="f926081",
    actor="Yao/Codex",
    title="declare DAYU600 as active port target",
    user_input="Clarify that westlake-piercing must be reproduced on the current DAYU600/uis7885 board, not only on DAYU200/RK3568.",
    agent_action="Updated repo skill, lock, pipeline, and docs for a DAYU600 port track; added a non-mutating dayu600-audit flow, live HDC audit checks, stock baseline hash inventory, and build-gap tracker.",
    code_delta="No runtime adapter behavior changed; added DAYU600 port metadata, docs, audit helpers, local stock baseline hash records, and source/build gap documentation.",
    verify="ran dayu600-audit over HDC; confirmed uis7885 arm64-v8a OpenHarmony 6.1.0.31, stock 64-bit appspawn, no appspawn-x, no /system/android substrate, and pulled stock appspawn/config/lib hashes",
    note=".repo-skill/turns/2026-07-01-dayu600-port-target.md"
  ];

  dayu600_2048_appspawn_child [
    commit="self",
    base_commit="pending",
    actor="Yao/Codex",
    title="run real 2048 APK inside DAYU600 app child",
    user_input="Run the attached 2048 APK on the OpenHarmony DAYU600 board using the A2OH/westlake-piercing port, not a rewritten clone.",
    agent_action="Added DAYU600 APK/framework/AppSpawnX fixtures, patched the aarch64 ART runtime for the standalone String.valueOf(int)/Integer.toString(int) path, added the embedded no-exit AppSpawnX path, deployed the probe runtime under /data/local/tmp, and joined aa start to a temporary AppSpawnX app-child route without replacing stock appspawn.",
    code_delta="Added reproducible DAYU600 2048 probe scripts and repo-skill flow entries; no /system binary replacement and no legacy 32-bit DAYU200 artifacts deployed.",
    verify="real com.digiplex.game.MainActivity.onCreate, privateR, gameStateJson, and gameMoveJson return RC:0 under standalone ART; temporary AppSpawnX app-child route runs embedded ART and onCreateNullTrace RC:0 inside m.digiplex.game while OHOS reaches AbilityTransitionDone",
    note=".repo-skill/turns/2026-07-02-dayu600-2048-appspawn-child.md"
  ];

  dayu600_hwui_gate1_2 [
    commit="self",
    base_commit="pending",
    actor="Yao/Claude",
    title="build libhwui.so + prove hwui renders on the DAYU600 panel",
    user_input="Drive the DAYU600 port toward running an Android game visibly on the board; build the real Android graphics stack and prove it renders.",
    agent_action="Built libhwui.so from AOSP 15 for aarch64-linux-ohos against the board's m133 Skia (gate 1); wrote a native RenderProxy harness + 5 interposer/shim TUs that make hwui's own pipeline render on the panel (gate 2, snapshot-verified); bisected gate 3 to a register_android_graphics_classes lifecycle-timeout in the embedded-ART child.",
    code_delta="Added the DAYU600 hwui build chain (scripts/, support-src/, include stubs), the gfx-smoke/ harness + interposers (fake libandroid, ANativeWindow shim, EGL + Skia interposers), and DAYU600-HWUI-BRINGUP.md; no /system writes; large outputs gitignored.",
    verify="gate 1: libhwui.so ELF64/AArch64 with full register_android_graphics_* exports; gate 2: on-device snapshot shows hwui-drawn green bg + red rect at exact recorded coords; gate 3: on-device A/B bisection + sysfreeze LIFECYCLE_TIMEOUT faultlog",
    note=".repo-skill/turns/2026-07-04-dayu600-hwui-gate1-2.md"
  ];

  agent_d3_input_verify_progress [
    commit="self",
    base_commit="pending",
    actor="Yao/Claude",
    title="Agent-D3 input verification boot image and WM stub progress",
    user_input="Continue Agent-D3 mission: verify WestLake input chain on DAYU600 board 5583f5be and produce WLTEST/WLTEXT markers in hilog.",
    agent_action="Corrected the embedded-art probe's -Ximage option so ART loads the arm64 boot image; pushed a patched probe binary; confirmed InputVerifyStage installs a WindowManager stub before View construction; ran inputVerify stage via app_process64 + BOOTCLASSPATH + WESTLAKE_BOOT_IMAGE=1.",
    code_delta="Modified westlake_embedded_art_dlopen_probe.c -Ximage suffix; added scratchpad-shared/wl-input-d/InputVerifyStage.java and WindowManagerAdapter.java; updated AGENT-COORD.md and AGENT-CHAT.md.",
    verify="Boot image loaded successfully and Dayu600ApkStageProbe reached ActivityThread.systemMain(); new framework clinit failures (Build, ActivityManager/Random, MethodType) block InputVerifyStage.run; board 5583f5be disconnected after run.",
    note=".repo-skill/turns/2026-07-09-agent-d3-input-verify-progress.md"
  ];

  agent_audio_native_chain_verified [
    commit="self",
    base_commit="pending",
    actor="Yao/Claude",
    title="Agent-Audio native audio chain verified end-to-end on DAYU600",
    user_input="Port the WestLake noice tap-to-speaker audio chain to 64-bit OHOS-6.1/A16 and verify it on DAYU600 boards; pause and document progress.",
    agent_action="Built arm64 audio bridges (libmedia_jni stub, liboh_mediacodec_shim, liboh_inproc_service), patched A16 framework.jar for audio focus and crash chain, wrote native_audiotest2_arm64 and toneplayer_arm64, and verified gates 3-6 on both DAYU600 boards with an audible 440Hz tone.",
    code_delta="Added scratchpad-shared/audio-port-64/ sources, scripts, runbook, and small verified binaries; updated REPO_LOCK.toml audio artifact hashes; removed accidentally tracked partial framework jar temp file.",
    verify="native_audiotest2_arm64 passes gate 3 (libmedia_jni dlopen) → gate 4 (register_MediaCodec_shim) → gate 5 (pthread detach) → gate 6 (OH_AudioStreamBuilder 440Hz tone) on 5583f5be and 5ce2dcee; toneplayer_arm64 also plays audible tone; gates 1-2 remain blocked by missing Java runtime.",
    note=".repo-skill/turns/2026-07-09-agent-audio-native-chain-verified.md"
  ];

  repo_skill_v0 -> claude_code_adapter -> repo_skill_cleanup -> dayu600_port_target -> dayu600_2048_appspawn_child -> dayu600_hwui_gate1_2 -> agent_d3_input_verify_progress -> agent_audio_native_chain_verified;
}
