digraph westlake_repo_history {
  graph [
    format="repo-skill-history-v0",
    rule="each node records one agent-facing change; commit=self is allowed only for the node introduced by the current commit"
  ];

  repo_skill_v0 [
    commit="fb3661c",
    base_commit="b9ede74ac6a19e9e05e09800a4c8757b60ea48d5",
    actor="Yao/Codex",
    title="add repo skill v0",
    user_input="Fork westlake-piercing to BH3GEI and add a dynamic repo skill system with DOT pipeline, lock, history, and skill-local tools.",
    agent_action="Created REPO_SKILL.md, REPO_PIPELINE.dot, REPO_LOCK.toml, REPO_HISTORY.dot, .repo-skill/SKILL.md, runner code, checks, and turn notes.",
    code_delta="No runtime adapter behavior changed; added collaboration and reproducibility metadata plus a local DOT runner.",
    verify="static runner checks; full replay requires DAYU200 and artifact baseline",
    note=".repo-skill/turns/2026-06-30-repo-skill-v0.md"
  ];

  claude_code_adapter [
    commit="6113f4b",
    base_commit="fb3661c",
    actor="Yao/Codex",
    title="add Claude Code skill adapter",
    user_input="Add the Claude Code layer so Claude can discover the repo skill without duplicating the main rules.",
    agent_action="Created .claude/skills/westlake-repo/SKILL.md and linked REPO_SKILL.md as the single source of truth.",
    code_delta="No runtime adapter behavior changed; added Claude Code discovery metadata and updated repo skill history.",
    verify="static file checks; full replay still requires DAYU200, hdc, and external artifacts",
    note=".repo-skill/turns/2026-06-30-claude-code-adapter.md"
  ];

  repo_skill_cleanup [
    commit="f926081",
    base_commit="6113f4b",
    actor="Yao/Codex",
    title="clean up repo skill metadata",
    user_input="Inspect BH3GEI/westlake-piercing, especially its built-in repo skill.",
    agent_action="Added Codex frontmatter to .repo-skill/SKILL.md, rewrote mojibake Claude adapter and turn note, improved missing-command/9009 reporting, and recorded this cleanup turn.",
    code_delta="No runtime adapter behavior changed; cleaned repository skill metadata, agent-facing history, and runner diagnostics.",
    verify="static skill checks; repo-local check flow fails honestly on this Windows host before hardware/artifact verification",
    note=".repo-skill/turns/2026-07-01-repo-skill-cleanup.md"
  ];

  dayu600_port_target [
    commit="pending",
    base_commit="f926081",
    actor="Yao/Codex",
    title="declare DAYU600 as active port target",
    user_input="Clarify that westlake-piercing must be reproduced on the current DAYU600/uis7885 board, not only on DAYU200/RK3568.",
    agent_action="Updated repo skill, lock, pipeline, and docs for a DAYU600 port track; added a non-mutating dayu600-audit flow, live HDC audit checks, stock baseline hash inventory, and build-gap tracker.",
    code_delta="No runtime adapter behavior changed; added DAYU600 port metadata, docs, audit helpers, local stock baseline hash records, and source/build gap documentation.",
    verify="ran dayu600-audit over HDC; confirmed uis7885 arm64-v8a OpenHarmony 6.1.0.31, stock 64-bit appspawn, no appspawn-x, no /system/android substrate, and pulled stock appspawn/config/lib hashes",
    note=".repo-skill/turns/2026-07-01-dayu600-port-target.md"
  ];

  dayu600_2048_appspawn_child [
    commit="self",
    base_commit="pending",
    actor="Yao/Codex",
    title="run real 2048 APK inside DAYU600 app child",
    user_input="Run the attached 2048 APK on the OpenHarmony DAYU600 board using the A2OH/westlake-piercing port, not a rewritten clone.",
    agent_action="Added DAYU600 APK/framework/AppSpawnX fixtures, patched the aarch64 ART runtime for the standalone String.valueOf(int)/Integer.toString(int) path, added the embedded no-exit AppSpawnX path, deployed the probe runtime under /data/local/tmp, and joined aa start to a temporary AppSpawnX app-child route without replacing stock appspawn.",
    code_delta="Added reproducible DAYU600 2048 probe scripts and repo-skill flow entries; no /system binary replacement and no legacy 32-bit DAYU200 artifacts deployed.",
    verify="real com.digiplex.game.MainActivity.onCreate, privateR, gameStateJson, and gameMoveJson return RC:0 under standalone ART; temporary AppSpawnX app-child route runs embedded ART and onCreateNullTrace RC:0 inside m.digiplex.game while OHOS reaches AbilityTransitionDone",
    note=".repo-skill/turns/2026-07-02-dayu600-2048-appspawn-child.md"
  ];

  repo_skill_v0 -> claude_code_adapter -> repo_skill_cleanup -> dayu600_port_target -> dayu600_2048_appspawn_child;
}
